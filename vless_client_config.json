{
    "v": "2",
    "ps": "Cloudflare-VLESS",
    "add": "vless.yourdomain.com",
    "port": "443",
    "id": "YOUR_VLESS_UUID",
    "aid": "0",
    "net": "ws",
    "type": "none",
    "host": "vless.yourdomain.com",
    "path": "/?ed=2048",
    "tls": "tls",
    "sni": "vless.yourdomain.com"
}

// PENJELASAN PENGATURAN PENTING:
// ===================================
// "ps": "Cloudflare-VLESS"
//   -> Nama koneksi. Anda bisa mengubah ini menjadi apa pun.
//
// "add": "vless.yourdomain.com"
//   -> Ganti dengan domain atau subdomain yang Anda arahkan ke Cloudflare Worker.
//
// "port": "443"
//   -> Biarkan 443. Ini adalah port standar untuk lalu lintas terenkripsi (WSS).
//
// "id": "YOUR_VLESS_UUID"
//   -> Ganti dengan UUID VLESS Anda. Harus sama persis dengan yang ada di
//      skrip worker Anda.
//
// "host": "vless.yourdomain.com"
//   -> Ganti dengan domain Anda.
//
// "path": "/?ed=2048"
//   -> JANGAN UBAH INI. Skrip worker ini dirancang untuk bekerja dengan path ini.
//
// "tls": "tls"
//   -> Mengaktifkan enkripsi TLS. Wajib.
//
// "sni": "vless.yourdomain.com"
//   -> Ganti dengan domain Anda. Ini memastikan koneksi Anda diarahkan dengan benar.
// ===================================

// Cara Menggunakan:
// 1. Salin format JSON di atas.
// 2. Ganti placeholder (seperti "vless.yourdomain.com" dan "YOUR_VLESS_UUID")
//    dengan nilai Anda yang sebenarnya.
// 3. Impor konfigurasi ini ke klien V2Ray Anda (misalnya, v2rayN, Qv2ray, AnXray).
//    Biasanya ada opsi untuk mengimpor dari clipboard atau file.
