{
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            // Address: Ganti dengan Bug Host yang Anda konfigurasikan di skrip.
            "address": "api24-normal-alisg.tiktokv.com",
            "port": 443,
            "users": [
              {
                // ID: Ganti dengan userID (UUID) yang Anda konfigurasikan di skrip.
                "id": "d342d11e-d424-4583-b36e-524ab1f0afa4",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          // serverName (SNI): Ganti dengan salah satu subdomain wildcard Anda.
          "serverName": "sub.yourdomain.com",
          "allowInsecure": false
        },
        "wsSettings": {
          // Path: Bisa berupa path acak.
          "path": "/your-random-path",
          "headers": {
            // Host: Harus sama dengan serverName (SNI) Anda.
            "Host": "sub.yourdomain.com"
          }
        }
      },
      "tag": "proxy"
    }
  ]
}
